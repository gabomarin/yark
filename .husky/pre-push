#!/usr/bin/env sh
set -e
. "$(dirname "$0")/common.sh"

echo "husky (pre-push): format check..."
npm_host run format:check
echo "husky (pre-push): typecheck..."
npm_host run typecheck
echo "husky (pre-push): knip..."
npm_host run knip
echo "husky (pre-push): typecheck and knip ok — running tests..."
npm_host test
echo "husky (pre-push): lint..."
npm_host run lint
echo "husky (pre-push): ok"
