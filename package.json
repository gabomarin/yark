{
  "name": "yark-server-manager",
  "version": "0.4.0",
  "description": "YARK server manager — local ARK Survival Ascended dedicated server manager for Windows",
  "main": "out/main/index.js",
  "author": "Gabriel",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.cjs",
    "catalog:ui-categories": "node scripts/build-asa-setting-ui-categories.cjs",
    "e2e:smoke": "node scripts/e2e-smoke.cjs",
    "e2e": "node scripts/e2e-suite.cjs",
    "e2e:mods": "node scripts/e2e-mods.cjs",
    "website:screenshots": "node scripts/capture-website-screenshots.cjs",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^9.5.0",
    "@mantine/form": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/modals": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "ini": "^5.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.yark.servermanager",
    "productName": "YARK server manager",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}
