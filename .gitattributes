# Default: normalize text files and keep LF in repo/worktree.
* text=auto

# Source and config files should stay LF across platforms.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sh text eol=lf
.husky/** text eol=lf

# Windows-native scripts.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary