YARK_CURSEFORGE_PROXY_URL=https://mods-proxy.example.com

# Optional: isolated Electron userData for local/dev (never mutates real AppData).
# YARK_E2E_USER_DATA=C:\yark_dev_profile
#
# With an isolated profile, E2E shortcuts (skip splash/wizard/What's new, isolate
# SteamCMD host discovery, suppress OS toasts) are on by default. Set this to keep
# normal operator UI while still using the isolated folder:
# YARK_E2E_FULL_UI=true
