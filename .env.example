YARK_CURSEFORGE_PROXY_URL=https://mods-proxy.example.com

# Optional: isolated Electron userData for local/dev (never mutates real AppData).
# Required if an installed YARK may also be open — without this, unpackaged shares
# the packaged AppData SQLite profile and concurrent writes can corrupt it.
# YARK_E2E_USER_DATA=C:\yark_dev_profile
#
# With an isolated profile, E2E shortcuts (skip splash/wizard/What's new, isolate
# SteamCMD host discovery, suppress OS toasts) are on by default. Set this to keep
# normal operator UI while still using the isolated folder (boolean: true/false;
# invalid or unset values keep shortcuts on — the safe default):
# YARK_E2E_FULL_UI=true

# Optional: dev-only theme/palette preview controls in the sidebar (palette, accent,
# plate warmth, surface lifts, contrast readout, brand-art motif). Off unless set;
# restart `npm run dev` after changing it:
# YARK_DEBUG_THEME=1