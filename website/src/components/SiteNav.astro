---
import { withBase } from "../data/site";
import SiteNavLinks from "./SiteNavLinks.astro";
---

<header class="site-nav">
  <div class="site-nav-inner">
    <a class="site-nav-brand" href={withBase("/")}>
      <img src={withBase("/favicon-32x32.png")} alt="" width="28" height="28" />
      <span>YARK</span>
    </a>
    <nav class="site-nav-links" aria-label="Primary">
      <SiteNavLinks />
    </nav>
    <details class="mobile-nav">
      <summary>
        <span class="visually-hidden">Open navigation</span>
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile primary">
        <SiteNavLinks />
      </nav>
    </details>
  </div>
</header>
