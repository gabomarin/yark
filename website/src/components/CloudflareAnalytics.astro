---
/**
 * Cloudflare Web Analytics beacon (privacy-first, cookieless).
 * Token comes from `PUBLIC_CF_WEB_ANALYTICS_TOKEN` at build time.
 * Omit the env var for local preview without analytics.
 */
const token = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
const enabled = typeof token === "string" && token.trim().length > 0;
const beacon = enabled
  ? JSON.stringify({ token: token.trim(), spa: false })
  : "";
---

{
  enabled && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={beacon}
    />
  )
}
