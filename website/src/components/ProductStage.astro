---
import ResponsiveShot from "./ResponsiveShot.astro";
import { SHOT_WIDTHS } from "../data/screenshot-media.mjs";
import { screenshotSlug, type Screenshot } from "../data/screenshots";

interface Props {
  shots: Screenshot[];
}

const { shots } = Astro.props;
const featured = shots.slice(0, 5);
const stageSizes = "(max-width: 720px) 100vw, min(78rem, 100vw)";
---

<section class="product-band" aria-label="Live product preview" data-reveal>
  <div class="product-band-inner">
    <div class="product-stage" data-product-stage>
      <div class="product-glow" aria-hidden="true"></div>
      <div class="product-perspective">
        <div class="product-frame" data-product-frame>
          <div class="product-bezel">
            <div class="product-rotator" data-product-rotator>
              {
                featured.map((shot, index) => (
                  <figure
                    class:list={["product-slide", index === 0 && "is-active"]}
                    data-product-slide
                        tabindex={index === 0 ? 0 : undefined}
                    data-caption={shot.caption}
                    id={`preview-panel-${index}`}
                    role="tabpanel"
                    aria-labelledby={`preview-tab-${index}`}
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    <ResponsiveShot
                      slug={screenshotSlug(shot)}
                      alt={shot.alt}
                      fallbackSrc={shot.src}
                      widths={[...SHOT_WIDTHS]}
                      sizes={stageSizes}
                      width={1440}
                      height={900}
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "low" : undefined}
                    />
                  </figure>
                ))
              }
            </div>
            <button class="product-arrow product-arrow-prev" type="button" data-product-prev aria-label="Show previous preview">←</button>
            <button class="product-arrow product-arrow-next" type="button" data-product-next aria-label="Show next preview">→</button>
          </div>
        </div>
      </div>
      <p class="product-caption" data-product-caption data-reveal-child>
        {featured[0]?.caption}
      </p>
      <div class="product-controls" data-reveal-child>
        <div class="product-dots" role="tablist" aria-label="Preview screens">
        {
          featured.map((shot, index) => (
            <button
              type="button"
              class:list={["product-dot", index === 0 && "is-active"]}
              data-product-dot
              id={`preview-tab-${index}`}
              role="tab"
              aria-controls={`preview-panel-${index}`}
              aria-label={`Show: ${shot.caption}`}
              aria-selected={index === 0 ? "true" : "false"}
            />
          ))
        }
        </div>
      </div>
    </div>
  </div>
</section>