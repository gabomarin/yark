---
interface Props {
  name: "servers" | "files" | "mods" | "config" | "backups" | "maintenance" | "hosted" | "maps";
}

const { name } = Astro.props;
---

<svg class="feature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {
    name === "servers" && (
      <>
        <rect x="3.5" y="4" width="17" height="6" rx="1.5" />
        <rect x="3.5" y="14" width="17" height="6" rx="1.5" />
        <path d="M7 7h.01M7 17h.01M11 7h6M11 17h6" />
      </>
    )
  }
  {
    name === "files" && (
      <>
        <path d="M12 3v11m0 0 4-4m-4 4-4-4" />
        <path d="M5 14.5V19a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4.5" />
      </>
    )
  }
  {
    name === "mods" && (
      <>
        <path d="m12 3 7.5 4.2v9.6L12 21l-7.5-4.2V7.2L12 3Z" />
        <path d="m4.8 7.4 7.2 4 7.2-4M12 11.4V21" />
      </>
    )
  }
  {
    name === "config" && (
      <>
        <path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h7M15 18h5" />
        <circle cx="15" cy="6" r="2" />
        <circle cx="9" cy="12" r="2" />
        <circle cx="13" cy="18" r="2" />
      </>
    )
  }
  {
    name === "backups" && (
      <>
        <path d="M5 7.5h14v11H5z" />
        <path d="M4 7.5 6 4h12l2 3.5M9 12h6M9 15h4" />
      </>
    )
  }
  {
    name === "maintenance" && (
      <>
        <path d="M14.7 6.3a4 4 0 0 0-5 5L4 17l3 3 5.7-5.7a4 4 0 0 0 5-5l-2.4 2.4-3-3 2.4-2.4Z" />
      </>
    )
  }
  {
    name === "hosted" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M3.8 12h16.4M12 3.5c2.1 2.25 3.2 5.1 3.2 8.5S14.1 18.25 12 20.5C9.9 18.25 8.8 15.4 8.8 12S9.9 5.75 12 3.5Z" />
        <path d="M7 5.7C8.4 6.8 10.1 7.4 12 7.4s3.6-.6 5-1.7M7 18.3c1.4-1.1 3.1-1.7 5-1.7s3.6.6 5 1.7" />
      </>
    )
  }
  {
    name === "maps" && (
      <>
        <path d="M4 5.5 9 3l6 3 5-2.5v15L15 21l-6-3-5 2.5v-15Z" />
        <path d="M9 3v15M15 6v15" />
        <circle cx="12" cy="10" r="1.7" />
        <path d="M12 14c1.5-1.8 2.3-3 2.3-4.2a2.3 2.3 0 1 0-4.6 0c0 1.2.8 2.4 2.3 4.2Z" />
      </>
    )
  }
</svg>

<style>
  .feature-icon {
    width: 1.45rem;
    height: 1.45rem;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
