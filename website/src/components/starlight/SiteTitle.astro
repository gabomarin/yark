---
import { withBase } from "../../data/site";
---

<span class="yark-docs-brand">
  <a class="yark-docs-brand__home" href={withBase("/")} data-astro-prefetch>
    <img src={withBase("/favicon-32x32.png")} alt="" width="28" height="28" />
    <span>YARK</span>
  </a>
  <a class="yark-docs-brand__docs" href={withBase("/docs/")} data-astro-prefetch>Docs</a>
</span>

<style>
  .yark-docs-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2rem;
  }

  .yark-docs-brand__home {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-white);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .yark-docs-brand__home:hover {
    color: var(--sl-color-accent-high);
  }

  .yark-docs-brand__home img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }

  .yark-docs-brand__docs {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    color: var(--sl-color-accent-high);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .yark-docs-brand__docs:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
  }
</style>
