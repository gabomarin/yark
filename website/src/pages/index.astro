---
import BaseLayout from "../layouts/BaseLayout.astro";
import DiscordIcon from "../components/DiscordIcon.astro";
import DownloadIcon from "../components/DownloadIcon.astro";
import GithubIcon from "../components/GithubIcon.astro";
import ProductStage from "../components/ProductStage.astro";
import ResponsiveShot from "../components/ResponsiveShot.astro";
import { site, withBase } from "../data/site";
import { SHOT_WIDTHS } from "../data/screenshot-media.mjs";
import { screenshotSlug, screenshots } from "../data/screenshots";
import { roadmapItems } from "../data/roadmap";
import { changelog } from "../data/changelog";

const logoSizes = "(max-width: 22rem) calc(100vw - 3rem), 22rem";
const gallerySizes = "(max-width: 720px) calc(100vw - 3rem), calc(min(72rem, 100vw) / 2)";
/*
 * The hero stage already shows the first five shots, and the section below used to render the
 * whole set again - the same captures twice, and a wall of full-app screenshots before the page
 * had made its argument. The section keeps four surfaces that the stage does not show, so nothing
 * is repeated; the rest live at /screenshots/.
 */
const gallerySlugs = ["workspace-mods", "backups", "logs", "settings"];
const galleryShots = screenshots.filter((shot) => gallerySlugs.includes(screenshotSlug(shot)));
/*
 * Momentum, from the same source the app's What's new modal reads - the shared curated
 * changelog. No network call, no hand-copied version, and it cannot go stale: when a release
 * is cut, the landing says so.
 */
const latestRelease = changelog[0];
const latestHighlights = (
  latestRelease?.sections.find((section) => section.title === "Highlights")?.items ??
  latestRelease?.sections[0]?.items ??
  []
).slice(0, 3);
const logoSrcset = `${withBase("/media/yark-logo-320.webp")} 320w, ${withBase("/media/yark-logo-640.webp")} 640w`;
---

<BaseLayout title={site.seoTitle} description={site.description} path="/" softwareSchema>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={withBase("/media/yark-logo-640.webp")}
      imagesrcset={logoSrcset}
      imagesizes={logoSizes}
      fetchpriority="high"
    />
  </Fragment>
  <Fragment slot="before-main">
    <header class="hero">
      <div class="brand-lockup" data-hero-item>
        <ResponsiveShot
          slug="yark-logo"
          alt=""
          fallbackSrc={withBase("/assets/yark-logo.png")}
          widths={[320, 640]}
          sizes={logoSizes}
          width={420}
          height={420}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <h1 class="hero-title" data-hero-item>
        YARK — ARK Survival Ascended dedicated server manager for Windows
      </h1>
      <p class="lede" data-hero-item>
        Local ARK: Survival Ascended dedicated servers on Windows — managed from one
        desktop shell. Profiles, SteamCMD, mods, backups, logs, and INI in a single app.
      </p>
      <div class="cta-row" data-hero-item>
        <a class="cta primary" href={site.downloadUrl}>
          <DownloadIcon />
          {site.downloadLabel}
        </a>
        <a class="cta ghost" href={site.releasesUrl}>All releases</a>
        <a class="cta ghost" href={site.repoUrl}>
          <GithubIcon />
          GitHub
        </a>
        <a class="cta ghost" href={site.discordUrl}>
          <DiscordIcon />
          Discord
        </a>
      </div>
      <p class="status-pill" data-hero-item>{site.statusLabel}</p>
      <p class="release-trust" data-hero-item>
        Public prerelease — download only from this site or GitHub Releases.{" "}
        <a href={withBase("/docs/getting-started/#verify-your-download")}
          >Verify the official download before installing</a
        >.
      </p>
    </header>

    <ProductStage shots={screenshots} />

    <section class="section" id="latest" data-reveal>
      <h2 data-reveal-child>Latest release</h2>
      <p class="section-lede" data-reveal-child>
        <strong>{latestRelease?.version}</strong>{latestRelease?.date ? ` - ${latestRelease.date}` : ""}.{" "}
        <a href={withBase("/changelog/")}>Full changelog</a>.
      </p>
      <ul class="feature-list" data-reveal-child>
        {latestHighlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    <section class="showcase" id="screenshots" aria-label="Application screenshots" data-reveal>
      <div class="showcase-inner">
        <p class="showcase-eyebrow" data-reveal-child>A look at the app</p>
        <h2 class="showcase-title" data-reveal-child>The surfaces that carry the work</h2>
        <p class="showcase-lede" data-reveal-child>
          Captured from the Electron + React desktop shell. Interface is under active
          development and may change between builds.
        </p>
        <div class="shots">
          {
            galleryShots.map((shot) => (
              <figure class="shot" data-reveal-child>
                <a href={shot.src} target="_blank" rel="noopener">
                  <ResponsiveShot
                    slug={screenshotSlug(shot)}
                    alt={shot.alt}
                    fallbackSrc={shot.src}
                    widths={[...SHOT_WIDTHS]}
                    sizes={gallerySizes}
                    width={1440}
                    height={900}
                    loading="lazy"
                  />
                </a>
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))
          }
        </div>
        <div class="cta-row" data-reveal-child>
          <a class="cta ghost" href={withBase("/screenshots/")}>Open the full gallery</a>
        </div>
      </div>
    </section>
  </Fragment>

  <section class="section" id="why" data-reveal>
    <h2 data-reveal-child>Why YARK exists</h2>
    <p class="section-lede" data-reveal-child>
      YARK started because I was tired of the tools I used to manage my ASA servers. They
      worked, but I spent too much time fighting their configuration screens — and several
      features I wanted sat behind paid tiers.
    </p>
    <p class="section-lede" data-reveal-child>
      I wanted a Windows app that was easier to live with, ran on my own machine, and did
      not lock the useful parts behind a paywall. At first it was just for my own servers.
        Once it became useful enough, I released it as a free, open-source prerelease.
      </p>
    </section>

    <section class="section" id="not" data-reveal>
      <h2 data-reveal-child>What it is not</h2>
      <p class="section-lede" data-reveal-child>
        YARK is not a cloud host, not an ARK game client launcher, and not an official
        Wildcard product. It is an independent local manager for dedicated-server tooling you
        run on your own machine.
      </p>
    </section>

    <section class="section" id="scope" data-reveal>
      <h2 data-reveal-child>What it does</h2>
      <p class="section-lede" data-reveal-child>
        Built and exercised in early public prerelease builds (Electron + React + TypeScript on
        Windows). This is not a shipping product checklist.
      </p>
      <div class="feature-grid" data-reveal-child>
        <article class="feature-card">
          <h3>Profiles and lifecycle</h3>
          <p>Several ARK profiles in one shell, with start, stop, restart, force-stop and optional auto-start.</p>
        </article>
        <article class="feature-card">
          <h3>Server files</h3>
          <p>Install, update and verify with SteamCMD, queue jobs on Downloads, and Update All for a fleet that is stopped and outdated.</p>
        </article>
        <article class="feature-card">
          <h3>Mods and maps</h3>
          <p>CurseForge Project IDs that survive an enable/disable cycle, Discover browsing, and map-mod linking for custom maps.</p>
        </article>
        <article class="feature-card">
          <h3>Workspace and INI</h3>
          <p>Visual or raw INI editing, curated launch flags with a command preview, an RCON console, and a configuration assistant on demand.</p>
        </article>
        <article class="feature-card">
          <h3>Backups and logs</h3>
          <p>Create, restore, export and import backups, with operation history, retention and fleet-wide alerts.</p>
        </article>
        <article class="feature-card">
          <h3>Clusters and maintenance</h3>
          <p>Cluster membership, shared INI templates and compliance checks, plus scheduled restarts, optional dino wipes and update warnings.</p>
        </article>
      </div>
      <p class="section-lede" data-reveal-child>
        <a href={withBase("/docs/")}>The docs cover the full surface</a> - every tab, every setting.
      </p>
    </section>

  <section class="section" id="roadmap" data-reveal>
    <h2 data-reveal-child>Next on the roadmap</h2>
    <p class="section-lede" data-reveal-child>
      Candidate product work after v0.20.0 — features operators will notice day to day.
      GitHub milestones stay authoritative; nothing here promises a stable 1.0 date.
    </p>
    <ul class="roadmap-list" data-reveal-child>
      {
        roadmapItems.map((item) => (
          <li>
            <span class:list={["tag", item.tag]}>
              {item.tag === "building" ? "Building" : "Planned"}
            </span>
            {item.text}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="what-is" data-reveal>
    <h2 data-reveal-child>ARK Survival Ascended dedicated server manager</h2>
    <p class="section-lede" data-reveal-child>
      YARK is a Windows desktop <strong>ASA dedicated server manager</strong> for hosts who run
      local ARK: Survival Ascended servers. Instead of juggling SteamCMD folders, INI files,
      CurseForge Project IDs, and backup scripts by hand, you keep multiple server profiles in
      one shell — install and update files, start and stop instances, schedule world backups,
      inspect logs, and edit configuration with a visual INI editor and guided assistant.
    </p>
  </section>

    <section class="section" id="privacy" data-reveal>
    <h2 data-reveal-child>Privacy and data</h2>
    <p class="section-lede" data-reveal-child>
      Server profiles and app settings stay on your PC (local SQLite). There is no YARK cloud
      account. Network use covers SteamCMD content, Wildcard’s public official-status CDN,
      and CurseForge mod metadata via a small{" "}
      <a href="https://github.com/gabomarin/yark/tree/main/workers/curseforge-proxy"
        >Cloudflare Worker proxy</a
      >. The desktop app never embeds a CurseForge API key.
      Server/admin credentials required by ASA remain local and may be present in app data,
      INI files, and INI backups. See{" "}
      <a href={withBase("/docs/security-privacy/")}>Security &amp; privacy</a> for the current
      protection boundary.
    </p>
  </section>

  <section class="section" id="about" data-reveal>
    <h2 data-reveal-child>About this site</h2>
    <p class="section-lede" data-reveal-child>
      Product pages and operator docs for YARK. Source and license: GPL-3.0 on{" "}
      <a href={site.repoUrl}>GitHub</a>. Chat and support:{" "}
      <a href={site.discordUrl}>Discord</a>.
    </p>
  </section>
</BaseLayout>
<style>
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 800px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .feature-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--bg-1) 70%, transparent);
  }

  .feature-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }

  .feature-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* A screenshot reads as a running app, not a flat image. */
  .shot img {
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
</style>
